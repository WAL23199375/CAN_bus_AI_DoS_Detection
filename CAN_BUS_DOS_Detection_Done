    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "# importing pandas to convert .txt file into a dataframe (basically a table)\n",
        "\n",
        "rows = []\n",
        "\n",
        "for line in lines:\n",
        "    try:\n",
        "        parts = line.strip().split()\n",
        "        # breaks down the text file into lines to be processed individually\n",
        "        # the parts line breaks each line into a list\n",
        "\n",
        "        timestamp = float(parts[parts.index(\"Timestamp:\") + 1])\n",
        "        # found values by keywords due to wrong number of fields in some lines\n",
        "        can_id = parts[parts.index(\"ID:\") + 1]\n",
        "        dlc = int(parts[parts.index(\"DLC:\") + 1])\n",
        "\n",
        "        dlc_index = parts.index(\"DLC:\") + 2\n",
        "        data_bytes = parts[dlc_index:dlc_index+8]\n",
        "\n",
        "        while len(data_bytes) < 8:\n",
        "            data_bytes.append(\"00\")\n",
        "            # filling in the data bytes\n",
        "\n",
        "        # the next lines designate what the headings of each part of data is (features)\n",
        "        label = 0\n",
        "        # allocates all these pieces of data as normal traffic\n",
        "\n",
        "        rows.append([timestamp, can_id, dlc] + data_bytes + [label])\n",
        "        # breaks down the txt lines into rows that data can be extracted from\n",
        "\n",
        "    except Exception as e:\n",
        "        # skipping incomplete lines\n",
        "        continue\n",
        "\n",
        "columns = [\"timestamp\", \"can_id\", \"dlc\",\n",
        "           \"data0\", \"data1\", \"data2\", \"data3\",\n",
        "           \"data4\", \"data5\", \"data6\", \"data7\",\n",
        "           \"label\"]\n",
        "# assigns the columns into labels that the data will be sorted into\n",
        "\n",
        "df = pd.DataFrame(rows, columns=columns)\n",
        "# creates the data frame\n",
        "\n",
        "df.head()\n",
        "#shows a few rows as an example\n"
      ],
